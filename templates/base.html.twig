<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <title>{% block title %}SportShop{% endblock %}</title>
        
        {% block stylesheets %}
        <style>
         body { font-family: inherit; }
    #cartOffcanvas:not(.show) {
        visibility: hidden !important;
        transform: translateX(100%) !important;
    }
    .offcanvas {
        visibility: hidden !important;
        transform: translateX(100%);
        transition: transform 0.3s ease, visibility 0.3s ease;
    }
    .offcanvas.show {
        visibility: visible !important;
        transform: translateX(0);
    }
</style>

        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </head>
    <body class="bg-white">
        
        <nav class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
            <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
                
                <!-- Left Section: Logo & Links -->
                <div class="flex items-center gap-10">
                    <a class="text-xl font-black uppercase tracking-tighter text-black" href="{{ path('home') }}">
                        Sport<span class="text-accent">Shop</span>
                    </a>

                    <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
                        <li><a href="{{ path('home') }}" class="text-[13px] font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors">Accueil</a></li>
                        <li><a href="{{ path('app_product_catalog') }}" class="text-[13px] font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors">Catalogue</a></li>
                        <li><a href="{{ path('app_contact') }}" class="text-[13px] font-bold uppercase tracking-widest text-gray-400 hover:text-black transition-colors">Contact</a></li>
                    </ul>
                </div>

                <!-- Right Section: User Actions -->
                <div class="flex items-center gap-6">
                    {% if app.user %}
                        <div class="hidden lg:flex items-center gap-6 border-r border-gray-100 pr-6">
                            <a href="{{ path('app_account') }}" class="text-xs font-bold text-gray-400 hover:text-black uppercase tracking-wider">Profil</a>
                            <a href="{{ path('app_orders') }}" class="text-xs font-bold text-gray-400 hover:text-black uppercase tracking-wider">Commandes</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin') }}" class="text-[10px] bg-red-50 text-red-600 px-2 py-0.5 rounded font-black uppercase">Admin</a>
                            {% endif %}
                        </div>

                        <button class="relative p-2 text-gray-700 hover:bg-gray-50 rounded-full transition-all" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartOffcanvas">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
                            </svg>
                            <span class="absolute top-1 right-1 bg-black text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center ring-2 ring-white" id="cartCountBadge">0</span>
                        </button>

                        <form method="post" action="{{ path('app_logout') }}" class="m-0" data-turbo="false">
                            <button type="submit" class="text-gray-400 hover:text-red-500 transition-colors bg-transparent border-0 p-0 cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                                </svg>
                            </button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-xs font-black uppercase tracking-widest text-black">Connexion</a>
                        <a href="{{ path('app_register') }}" class="bg-black text-white text-[11px] font-black uppercase tracking-widest px-6 py-3 rounded hover:bg-gray-800 transition-all shadow-sm">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </nav>

      {% if app.user %}
    <div class="offcanvas offcanvas-end !w-80 border-l border-gray-100 shadow-xl" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel">

        <div class="offcanvas-header p-8">
            <h5 class="offcanvas-title font-black text-xl uppercase tracking-tighter" id="cartOffcanvasLabel">Votre panier</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body px-8" id="miniCart">
            <div id="miniCartContent" data-mini-cart-url="{{ path('app_cart_mini') }}">
                <div class="text-sm text-gray-400">Chargement...</div>
            </div>
        </div>

    </div>
{% endif %}
        <main>
            {% block body %}{% endblock %}
        </main>
    </body>
</html>