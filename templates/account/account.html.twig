{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 720px;">
    <h1 class="mb-4">Mon Compte</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Informations du profil</h5>
            {{ form_start(profileForm) }}
            {{ form_row(profileForm.nom) }}
            {{ form_row(profileForm.email) }}
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            {{ form_end(profileForm) }}
        </div>
    </div>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5 class="card-title">Changer le mot de passe</h5>
            {{ form_start(passwordForm) }}
            {{ form_row(passwordForm.currentPassword) }}
            {{ form_row(passwordForm.newPassword) }}
            {{ form_row(passwordForm.confirmPassword) }}
            <button type="submit" class="btn btn-primary">Mettre a jour</button>
            {{ form_end(passwordForm) }}
        </div>
    </div>

    <div class="mt-4">
        <a href="{{ path('app_orders') }}" class="btn btn-primary">Voir mes commandes</a>
    </div>
</div>
{% endblock %}
