{% extends 'base.html.twig' %}

{% block title %}Contact | Performance Store{% endblock %}

{% block body %}
<div class="bg-white min-h-screen relative overflow-hidden">
    <!-- Decorative background element -->
    <div class="absolute top-0 right-0 -translate-y-12 translate-x-12 blur-3xl opacity-10 pointer-events-none">
        <div class="h-96 w-96 rounded-full bg-indigo-600"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
        <div class="lg:grid lg:grid-cols-2 lg:gap-x-24 lg:items-center">
            
            <!-- Left: Brand Statement & Contact Info -->
            <div class="mb-16 lg:mb-0">
                <h1 class="text-5xl font-black italic tracking-tighter text-slate-900 uppercase leading-none sm:text-7xl">
                    ENTRE EN <br> <span class="text-indigo-600">CONTACT.</span>
                </h1>
                <p class="mt-8 text-lg font-medium text-slate-500 max-w-md leading-relaxed">
                    Besoin d'un conseil technique ou d'un suivi sur votre commande ? Notre équipe d'experts est là pour vous propulser.
                </p>

                <div class="mt-12 space-y-8">
                    <div class="flex items-center gap-6 group">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Email</p>
                            <p class="text-sm font-bold text-slate-900">support@performance-store.tn</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-6 group">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Siège</p>
                            <p class="text-sm font-bold text-slate-900">Tunis, Tunisie</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Contact Form -->
            <div class="bg-slate-50 p-8 sm:p-12 rounded-[2rem] border border-slate-100 shadow-2xl shadow-slate-200/50">
                {% for message in app.flashes('success') %}
                    <div class="mb-6 rounded-xl bg-emerald-50 p-4 border border-emerald-100 flex items-center gap-3">
                        <svg class="h-5 w-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm font-bold text-emerald-800">{{ message }}</p>
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1">Nom Complet</label>
                            {{ form_widget(form.name, {'attr': {'class': 'block w-full rounded-xl border-0 bg-white px-4 py-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 transition-all sm:text-sm'}}) }}
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1">Email</label>
                            {{ form_widget(form.email, {'attr': {'class': 'block w-full rounded-xl border-0 bg-white px-4 py-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 transition-all sm:text-sm'}}) }}
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1">Objet</label>
                        {{ form_widget(form.subject, {'attr': {'class': 'block w-full rounded-xl border-0 bg-white px-4 py-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 transition-all sm:text-sm'}}) }}
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1">Message</label>
                        {{ form_widget(form.message, {'attr': {'class': 'block w-full rounded-xl border-0 bg-white px-4 py-3 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-200 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 transition-all sm:text-sm', 'rows': '4'}}) }}
                    </div>

                    <button type="submit" class="group relative flex w-full items-center justify-center rounded-xl bg-indigo-600 px-8 py-4 text-sm font-bold text-white shadow-lg hover:bg-indigo-700 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 uppercase tracking-[0.2em]">
                        Envoyer le message
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}