{% extends 'base.html.twig' %}

{% block title %}Performance Shop | Catalogue{% endblock %}

{% block body %}
<div class="bg-slate-50 min-h-screen py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header & Search -->
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-10 gap-6">
            <div>
                <h1 class="text-4xl font-black italic tracking-tighter text-slate-900 uppercase">Catalogue <span class="text-indigo-600">Pro</span></h1>
                <p class="text-slate-500 font-medium">Équipement haute performance pour athlètes exigeants.</p>
            </div>
            
            <form action="{{ path('app_product_catalog') }}" method="get" class="w-full md:w-auto">
                <div class="flex items-center bg-white rounded-2xl shadow-sm border border-slate-200 p-2 focus-within:ring-2 focus-within:ring-indigo-500 transition-all">
                    <input type="text" name="q" 
                           class="block w-full border-0 bg-transparent py-2 pl-4 text-slate-900 placeholder:text-slate-400 focus:ring-0 sm:text-sm" 
                           placeholder="Rechercher (ex: Kettlebell)..." 
                           value="{{ searchTerm }}">
                    <button type="submit" class="bg-slate-900 text-white px-6 py-2 rounded-xl text-sm font-bold hover:bg-slate-800 transition-colors">
                        Rechercher
                    </button>
                </div>
            </form>
        </div>

        <div class="lg:grid lg:grid-cols-4 lg:gap-x-8">
            <!-- Sidebar Filters -->
            <aside class="hidden lg:block">
                <div class="sticky top-8 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-widest mb-6">Catégories</h3>
                    <ul class="space-y-4">
                        <li>
                            <a href="{{ path('app_product_catalog') }}" class="flex items-center text-sm font-medium {{ not selectedCategory ? 'text-indigo-600 font-bold' : 'text-slate-600 hover:text-indigo-600' }}">
                                Toutes les catégories
                            </a>
                        </li>
                        {% for category in categories %}
                        <li>
                            <a href="{{ path('app_product_catalog', {category: category.id}) }}" 
                               class="flex items-center justify-between text-sm font-medium {{ category.id == selectedCategory ? 'text-indigo-600 font-bold' : 'text-slate-600 hover:text-indigo-600' }}">
                                {{ category.libelle }}
                                <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">New</span>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </aside>

            <!-- Product Grid -->
            <div class="lg:col-span-3">
                {% if produits is not empty %}
                    <div class="grid grid-cols-1 gap-y-10 gap-x-6 sm:grid-cols-2 xl:gap-x-8">
                        {% for produit in produits %}
                        <div class="group relative flex flex-col bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-xl transition-all duration-300">
                            
                            <!-- Image Section -->
                            <div class="aspect-h-1 aspect-w-1 w-full overflow-hidden bg-slate-100 relative">
                                {% if produit.image %}
                                    <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                                         alt="{{ produit.nom }}" 
                                         class="h-64 w-full object-cover object-center transition-transform duration-500 group-hover:scale-105">
                                {% else %}
                                    <div class="h-64 flex items-center justify-center text-slate-300 italic text-xs uppercase tracking-widest">
                                        No Visual Available
                                    </div>
                                {% endif %}

                                <!-- Promo Badge -->
                                {% if produit.isPromo and produit.promoDiscount %}
                                    <div class="absolute top-4 left-4 z-10">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter shadow-sm bg-red-500 text-white">
                                            -{{ produit.promoDiscount }}%
                                        </span>
                                    </div>
                                {% endif %}
                                <!-- Stock Badge -->
                                <div class="absolute top-4 right-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter shadow-sm {{ produit.stock > 0 ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-600/20' : 'bg-rose-50 text-rose-700 ring-1 ring-rose-600/20' }}">
                                        {{ produit.stock > 0 ? 'Disponible' : 'Rupture' }}
                                    </span>
                                </div>
                            </div>

                            <!-- Content Section -->
                            <div class="p-6 flex flex-1 flex-col">
                                <div class="mb-4">
                                    <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-widest mb-1">{{ produit.categorie.libelle ?? 'Equipement' }}</p>
                                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-600 transition-colors">
                                        <a href="{{ path('app_product_details', {id: produit.id}) }}">
                                            <span aria-hidden="true" class="absolute inset-0"></span>
                                            {{ produit.nom }}
                                        </a>
                                    </h3>
                                    <div class="mt-2 text-sm text-slate-500 line-clamp-2">
                                        {{ produit.description|striptags }}
                                    </div>
                                </div>

                                <div class="mt-auto flex items-center justify-between pt-4 border-t border-slate-100">
                                    <div>
                                        {% if produit.isPromo and produit.promoDiscount %}
                                            <p class="text-xl font-black text-indigo-600">{{ produit.discountedPrice }} <span class="text-xs">DT</span></p>
                                            <p class="text-xs text-slate-400 line-through">{{ produit.prix }} DT</p>
                                        {% else %}
                                            <p class="text-xl font-black text-slate-900">{{ produit.prix }} <span class="text-xs">DT</span></p>
                                        {% endif %}
                                    </div>
                                    
                                    <div class="flex gap-2 relative z-10">
                                        {% if is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('app_cart_add', {id: produit.id}) }}" 
                                               class="inline-flex items-center justify-center p-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition-colors shadow-sm"
                                               title="Ajouter au panier">
                                               <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                               </svg>
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_login') }}" class="text-[10px] font-bold text-slate-400 uppercase hover:text-indigo-600 transition-all underline underline-offset-4">
                                                Login to buy
                                            </a>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-24 bg-white rounded-3xl border-2 border-dashed border-slate-200">
                        <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <h3 class="mt-4 text-sm font-bold text-slate-900 uppercase">Aucun produit trouvé</h3>
                        <p class="mt-1 text-sm text-slate-500 font-medium">Réessayez avec d'autres critères de recherche.</p>
                        <div class="mt-6">
                            <a href="{{ path('app_product_catalog') }}" class="inline-flex items-center rounded-xl bg-indigo-600 px-6 py-2 text-sm font-bold text-white shadow-sm hover:bg-indigo-500">
                                Tout afficher
                            </a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}