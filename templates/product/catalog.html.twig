{% extends 'base.html.twig' %}

{% block title %}Catalogue{% endblock %}

{% block body %}

<div class="container mt-4">
    <h1 class="mb-4">Catalogue de Produits</h1>

    <form action="{{ path('app_product_catalog') }}" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="q" class="form-control" placeholder="Rechercher un produit (ex: Haltères)..." value="{{ app.request.query.get('q') }}">
        <button class="btn btn-primary" type="submit">Rechercher</button>
    </div>
    </form>

    <div class="row">
        {% for produit in produits %}
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                {% if produit.image %}
                    <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 100px; object-fit: cover;">
                {% else %}
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="text-white">Pas d'image</span>
                    </div>
                {% endif %}

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">{{ produit.nom }}</h5>
                    <p class="text-muted small">{{ produit.categorie.libelle ?? 'Sans catégorie' }}</p>
                    <p>{{ produit.description|raw }}</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="fw-bold text-success fs-5">{{ produit.prix }} DT</span>
                        <span class="badge {{ produit.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                            {{ produit.stock > 0 ? 'En stock' : 'Rupture' }}
                        </span>
                    </div>
                    <a href="{{ path('app_product_details', {id: produit.id}) }}" class="btn btn-primary mt-3">
                        Voir détails
                    </a>
                    <a href="{{ path('app_cart_add', {id: produit.id}) }}" class="btn btn-success">
                        🛒 Ajouter au panier
                    </a>
                </div>
            </div>
        </div>
        {% else %}
            <p class="text-muted">Aucun produit disponible.</p>
        {% endfor %}
    </div>
</div>
{% endblock %}