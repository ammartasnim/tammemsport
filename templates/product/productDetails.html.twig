{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }}{% endblock %}

{% block body %}
<div class="container mt-4">

    <a href="{{ path('app_product_catalog') }}" class="btn btn-outline-secondary mb-4">
        ← Retour au catalogue
    </a>

    <div class="row">
        {# Image #}
        <div class="col-md-5">
            {% if produit.image %}
                <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="img-fluid rounded" alt="{{ produit.nom }}" style="height: 150px; object-fit: cover;">
            {% else %}
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 350px;">
                    <span class="text-white fs-4">Pas d'image</span>
                </div>
            {% endif %}
        </div>

        {# Details #}
        <div class="col-md-7">
            <h1>{{ produit.nom }}</h1>
            <p class="text-muted">Catégorie : {{ produit.categorie.libelle ?? 'Sans catégorie' }}</p>

            <hr>

            <p>{{ produit.description|raw }}</p>

            <div class="d-flex align-items-center gap-3 my-3">
                <span class="fs-3 fw-bold text-success">{{ produit.prix }} DT</span>
                <span class="badge fs-6 {{ produit.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                    {{ produit.stock > 0 ? 'En stock (' ~ produit.stock ~ ')' : 'Rupture de stock' }}
                </span>
            </div>

            {% if produit.stock > 0 %}
                {% if is_granted('ROLE_CLIENT') or is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_cart_add', {id: produit.id}) }}" class="btn btn-success" data-add-to-cart>
                        🛒 Ajouter au panier
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-success btn-lg">
                        Connectez-vous pour acheter
                    </a>
                {% endif %}
            {% else %}
                <button class="btn btn-secondary btn-lg" disabled>Indisponible</button>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}
