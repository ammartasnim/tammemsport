{% extends 'base.html.twig' %}

{% block title %}Passer commande{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Passer commande</h1>

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">Recapitulatif du panier</h5>

            {% if cart|length > 0 %}
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Prix</th>
                            <th>Quantite</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cart %}
                            <tr>
                                <td>{{ item.produit.nom }}</td>
                                <td>{{ item.produit.prix }} DT</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.produit.prix * item.quantity }} DT</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-semibold">Total a payer</td>
                            <td class="fw-bold text-success">{{ total }} DT</td>
                        </tr>
                    </tfoot>
                </table>

                <form method="post" action="{{ path('app_cart_checkout_confirm') }}">
                    <button type="submit" class="btn btn-success">Confirmer la commande</button>
                    <a href="{{ path('app_product_catalog') }}" class="btn btn-outline-secondary">Continuer mes achats</a>
                </form>
            {% else %}
                <div class="alert alert-info">Votre panier est vide.</div>
                <a href="{{ path('app_product_catalog') }}" class="btn btn-primary">Retour au catalogue</a>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
