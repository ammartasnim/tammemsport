{% if cart|length > 0 %}
    <ul class="divide-y divide-gray-100" id="miniCartList">
        {% for item in cart %}
        <li class="flex py-4 gap-4">
            <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg bg-gray-100">
                {% if item.produit.image %}
                    <img src="{{ asset('uploads/images/' ~ item.produit.image) }}" alt="{{ item.produit.nom }}" class="h-full w-full object-cover object-center" loading="lazy">
                {% else %}
                    <div class="flex h-full w-full items-center justify-center text-gray-300">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                {% endif %}
            </div>
            <div class="flex flex-1 flex-col justify-between min-w-0">
                <div>
                    <h4 class="text-sm font-bold text-gray-900 uppercase tracking-tight truncate">{{ item.produit.nom }}</h4>
                    <p class="text-xs text-gray-500 mt-0.5">{{ item.produit.discountedPrice }} DT × {{ item.quantity }}</p>
                </div>
                <div class="flex items-center justify-between mt-2">
                    <span class="text-sm font-black text-gray-900">{{ item.produit.discountedPrice * item.quantity }} DT</span>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_cart_remove', {id: item.produit.id}) }}" class="text-gray-400 hover:text-gray-600 transition-colors text-sm font-bold px-2" data-cart-action>−</a>
                        <span class="text-sm font-bold text-gray-900">{{ item.quantity }}</span>
                        <a href="{{ path('app_cart_add', {id: item.produit.id}) }}" class="text-gray-400 hover:text-gray-600 transition-colors text-sm font-bold px-2" data-cart-action>+</a>
                        <a href="{{ path('app_cart_delete', {id: item.produit.id}) }}" class="text-gray-300 hover:text-red-500 transition-colors ml-2" data-cart-action>
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </li>
        {% endfor %}
    </ul>
    <div class="mt-6 border-t border-gray-100 pt-4">
        <div class="flex items-center justify-between mb-4">
            <span class="text-sm font-bold text-gray-900 uppercase tracking-tight">Total</span>
            <span class="text-lg font-black text-gray-900">{{ total }} DT</span>
        </div>
        <a href="{{ path('app_cart_checkout') }}" class="flex w-full items-center justify-center rounded-xl bg-black text-white py-3 text-sm font-bold uppercase tracking-widest hover:bg-gray-800 transition-all shadow-sm">
            Commander
        </a>
    </div>
{% else %}
    <div class="text-center py-12">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-gray-50 text-gray-300 mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
        </div>
        <p class="text-sm text-gray-400 font-medium">Ton panier est vide</p>
    </div>
{% endif %}
<span data-cart-count="{{ cartCount }}" class="hidden"></span>
