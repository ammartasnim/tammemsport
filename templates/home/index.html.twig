{% extends 'base.html.twig' %}

{% block title %}Performance Store | Accueil{% endblock %}

{% block body %}
<div class="bg-white">
    <!-- Premium Hero Section -->
    <div class="relative bg-zinc-950 px-6 pt-14 lg:px-8 overflow-hidden">
        <div class="absolute inset-0 z-0">
            <div class="absolute top-0 -left-1/4 w-1/2 h-full bg-indigo-600/20 blur-[120px] rounded-full"></div>
            <div class="absolute bottom-0 -right-1/4 w-1/2 h-full bg-blue-600/10 blur-[120px] rounded-full"></div>
        </div>

        <div class="relative z-10 mx-auto max-w-2xl py-24 sm:py-32 lg:max-w-7xl lg:py-40">
            <div class="lg:max-w-2xl">
                <span class="inline-flex items-center rounded-full bg-indigo-500/10 px-3 py-1 text-sm font-medium text-indigo-400 ring-1 ring-inset ring-indigo-500/20 mb-6">
                    Nouvelle Collection 2026
                </span>
                <h1 class="text-5xl font-extrabold tracking-tight text-white sm:text-7xl">
                    DOMINE TON <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">TERRAIN</span>
                </h1>
                <p class="mt-8 text-lg leading-8 text-zinc-400 max-w-xl">
                    Équipez-vous avec le meilleur du matériel sportif. Performance, durabilité et style réunis dans une sélection exclusive.
                </p>
                <div class="mt-10 flex items-center gap-x-6">
                    <a href="{{ path('app_product_catalog') }}" class="rounded-full bg-white px-8 py-4 text-sm font-bold text-zinc-950 shadow-sm hover:bg-zinc-200 transition-all uppercase tracking-widest">
                        Explorer le Shop
                    </a>
                    <a href="#featured" class="text-sm font-semibold leading-6 text-white group">
                        Voir les offres <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Section -->
    <div id="featured" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
            <div>
                <h2 class="text-3xl font-black italic tracking-tighter text-zinc-900 uppercase">
                    {% if promos is not empty %}🔥 Offres Flash{% else %}⚡ Derniers Drops{% endif %}
                </h2>
                <p class="mt-2 text-zinc-500 font-medium">Équipement de niveau professionnel sélectionné pour vous.</p>
            </div>
            <a href="{{ path('app_product_catalog') }}" class="text-sm font-bold text-indigo-600 border-b-2 border-indigo-600 pb-1">TOUT VOIR</a>
        </div>

        <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {% set display_list = promos is not empty ? promos : latest %}
            
            {% for produit in display_list %}
                <div class="group relative">
                    <!-- Image Card -->
                    <div class="relative aspect-[4/5] w-full overflow-hidden rounded-2xl bg-zinc-100">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/images/' ~ produit.image) }}" 
                                 alt="{{ produit.nom }}" 
                                 class="h-full w-full object-cover object-center transition-transform duration-500 scale-100 group-hover:scale-110">
                        {% else %}
                            <div class="flex h-full w-full items-center justify-center bg-zinc-50 text-zinc-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        {% endif %}

                        <!-- Badge -->
                        {% if promos is not empty %}
                            <div class="absolute top-4 right-4">
                                <span class="bg-zinc-950 text-white text-[10px] font-black px-3 py-1.5 rounded-full uppercase tracking-tighter shadow-xl">
                                    -{{ produit.promoDiscount ?? 0 }}% OFF
                                </span>
                            </div>
                        {% endif %}

                        <!-- Quick Add Overlay -->
                        <div class="absolute inset-x-0 bottom-0 p-4 opacity-0 translate-y-4 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
                            <a href="{{ path('app_product_details', {id: produit.id}) }}" class="flex items-center justify-center w-full bg-white/90 backdrop-blur-md py-3 rounded-xl text-sm font-bold text-zinc-900 shadow-sm hover:bg-white transition-colors">
                                Quick View
                            </a>
                        </div>
                    </div>

                    <!-- Details -->
                    <div class="mt-6 flex justify-between items-start">
                        <div>
                            <h3 class="text-sm font-bold text-zinc-900 uppercase tracking-tight">
                                <a href="{{ path('app_product_details', {id: produit.id}) }}">
                                    {{ produit.nom }}
                                </a>
                            </h3>
                            <p class="mt-1 text-xs font-semibold text-zinc-400 uppercase">{{ produit.categorie.libelle ?? 'Training' }}</p>
                        </div>
                        <div class="text-right">
                            {% if produit.isPromo and produit.promoDiscount %}
                                <p class="text-sm font-black text-indigo-600">{{ produit.discountedPrice }} DT</p>
                                <p class="text-[10px] text-zinc-400 line-through">{{ produit.prix }} DT</p>
                            {% else %}
                                <p class="text-sm font-black text-zinc-900">{{ produit.prix }} DT</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Trust Markers -->
    <div class="border-t border-zinc-100 bg-zinc-50 py-12">
        <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
            <div>
                <p class="text-xs font-black uppercase tracking-widest text-zinc-900">Livraison Rapide</p>
                <p class="text-xs text-zinc-500 mt-1">Partout en Tunisie sous 48h</p>
            </div>
            <div>
                <p class="text-xs font-black uppercase tracking-widest text-zinc-900">Qualité Pro</p>
                <p class="text-xs text-zinc-500 mt-1">Équipement testé par des athlètes</p>
            </div>
            <div>
                <p class="text-xs font-black uppercase tracking-widest text-zinc-900">Support 24/7</p>
                <p class="text-xs text-zinc-500 mt-1">Une équipe à votre écoute</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}