{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="p-4 p-md-5 mb-4 rounded bg-light">
        <h1 class="display-6">Promotions du moment</h1>
        <p class="lead">Découvrez nos produits sportifs en promotion et profitez des meilleures offres.</p>
        <a href="{{ path('app_product_catalog') }}" class="btn btn-primary">Voir le catalogue</a>
    </div>

    {% if promos is not empty %}
        <h2 class="mb-3">Promos</h2>
        <div class="row">
            {% for produit in promos %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 160px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 160px;">
                                <span class="text-white">Pas d'image</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="text-muted small">{{ produit.categorie.libelle ?? 'Sans catégorie' }}</p>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger">-{{ produit.promoDiscount ?? 0 }}%</span>
                                <span class="fw-bold text-success">{{ produit.prix }} DT</span>
                            </div>
                            <a href="{{ path('app_product_details', {id: produit.id}) }}" class="btn btn-outline-primary mt-3">Voir details</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <h2 class="mb-3">Nouveautés</h2>
        <div class="row">
            {% for produit in latest %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/images/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 160px; object-fit: cover;">
                        {% else %}
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 160px;">
                                <span class="text-white">Pas d'image</span>
                            </div>
                        {% endif %}
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="text-muted small">{{ produit.categorie.libelle ?? 'Sans catégorie' }}</p>
                            <span class="fw-bold text-success">{{ produit.prix }} DT</span>
                            <a href="{{ path('app_product_details', {id: produit.id}) }}" class="btn btn-outline-primary mt-3">Voir details</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
