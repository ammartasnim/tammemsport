{% extends 'base.html.twig' %}

{% block title %}Accès Athlète | Performance Store{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-white lg:bg-zinc-950">
    <div class="flex w-full max-w-6xl h-full lg:h-[80vh] overflow-hidden lg:rounded-[3rem] lg:shadow-2xl lg:border lg:border-zinc-800">
        
        <!-- Left: Immersive Visual (Hidden on mobile) -->
        <div class="hidden lg:flex lg:w-1/2 bg-zinc-900 relative p-16 flex-col justify-between overflow-hidden">
            <!-- Blur background decorations -->
            <div class="absolute top-0 -left-20 w-96 h-96 bg-indigo-600/20 blur-[100px] rounded-full"></div>
            <div class="absolute bottom-0 -right-20 w-96 h-96 bg-blue-600/10 blur-[100px] rounded-full"></div>

            <div class="relative z-10">
                <h2 class="text-6xl font-black italic tracking-tighter text-white uppercase leading-none">
                    DÉPASSE <br> TES <span class="text-indigo-500">LIMITES.</span>
                </h2>
                <p class="mt-6 text-zinc-400 font-medium max-w-xs uppercase text-xs tracking-widest leading-loose">
                    Connectez-vous pour accéder à vos programmes, votre matériel et vos avantages exclusifs.
                </p>
            </div>

            <div class="relative z-10 mt-auto">
                <p class="text-xs font-black text-zinc-500 uppercase tracking-widest">Performance Store &copy; 2026</p>
            </div>
        </div>

        <!-- Right: Login Form Section -->
        <div class="w-full lg:w-1/2 bg-white p-8 sm:p-16 flex flex-col justify-center">
            <div class="max-w-md w-full mx-auto">
                <div class="mb-10">
                    <h1 class="text-3xl font-black italic tracking-tighter text-zinc-900 uppercase">Bienvenue <span class="text-indigo-600">Athlète</span></h1>
                    <p class="text-zinc-500 text-sm font-medium mt-2">Prêt pour la prochaine séance ?</p>
                </div>

                {% if error %}
                    <div class="mb-6 flex items-center gap-3 rounded-xl bg-rose-50 p-4 border border-rose-100">
                        <svg class="h-5 w-5 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm font-bold text-rose-800 tracking-tight">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="mb-8 p-4 rounded-xl bg-indigo-50 border border-indigo-100">
                        <p class="text-sm font-bold text-indigo-900">
                            Connecté en tant que : <span class="font-black italic">{{ app.user.userIdentifier }}</span>
                        </p>
                        <a href="{{ logout_path() }}" class="mt-2 inline-block text-xs font-black uppercase text-indigo-600 underline">Déconnexion</a>
                    </div>
                {% endif %}

                <form method="post" class="space-y-6">
                    <div class="space-y-2">
                        <label for="inputEmail" class="text-[10px] font-black uppercase tracking-widest text-zinc-400 ml-1">Email</label>
                        <div class="relative">
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" 
                                   class="block w-full rounded-xl border-zinc-200 bg-zinc-50 px-4 py-3.5 text-zinc-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm placeholder:text-zinc-400 transition-all" 
                                   placeholder="exemple@athlete.tn" required autofocus>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between ml-1">
                            <label for="inputPassword" class="text-[10px] font-black uppercase tracking-widest text-zinc-400">Mot de passe</label>
                        </div>
                        <input type="password" name="password" id="inputPassword" 
                               class="block w-full rounded-xl border-zinc-200 bg-zinc-50 px-4 py-3.5 text-zinc-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm transition-all" 
                               required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="flex items-center justify-between">
                        <label class="flex items-center group cursor-pointer">
                            <input type="checkbox" name="_remember_me" class="h-4 w-4 rounded border-zinc-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer">
                            <span class="ml-2 text-xs font-bold text-zinc-500 uppercase tracking-tighter group-hover:text-zinc-900 transition-colors">Rester connecté</span>
                        </label>
                    </div>

                    <button class="flex w-full items-center justify-center rounded-xl bg-zinc-950 px-8 py-4 text-sm font-black text-white uppercase tracking-[0.2em] shadow-xl hover:bg-zinc-800 focus:ring-2 focus:ring-zinc-950 focus:ring-offset-2 transition-all group" type="submit">
                        Se connecter
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-3 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </button>
                </form>

                <div class="mt-12 pt-8 border-t border-zinc-100 text-center">
                    <p class="text-xs font-bold text-zinc-400 uppercase tracking-tighter">
                        Pas encore membre ? 
                        <a href="#" class="text-indigo-600 hover:text-indigo-700 font-black">Rejoindre la communauté</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}